# ==============================================================================
# ArchAI Studio - Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build and production outputs
.next/
out/
build/
dist/
.turbo

# Python environments & cache
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/

# Environment files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.production.example

# Temporary 3D assets and raytraced renders
*.glb
*.gltf
*.ifc
*.obj
*.fbx
*.blend
*.blend1
tmp/
temp/
*archai_blender_out*
renders/
assets/temp/

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
celerybeat-schedule
celerybeat.pid

# Testing and coverage
coverage/
*.lcov

# IDE and OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
