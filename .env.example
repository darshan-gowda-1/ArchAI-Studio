# ==============================================================================
# ArchAI Studio v3 - Master Environment Variables Template
# Copy this file to .env and populate with your credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Database & Spatial PostGIS
DATABASE_URL=postgresql://archai_admin:archai_secure_pass_2026@localhost:5432/archai_v3_db

# Redis Message Broker & State Cache
REDIS_URL=redis://localhost:6379/0

# OpenAI API (Requirements NLP, Vision Analysis & Design Rationale)
OPENAI_API_KEY=your_openai_api_key_here

# Google Solar API (Solar Flux, Shading & Roof Segments)
GOOGLE_SOLAR_API_KEY=your_google_solar_api_key_here

# Meshy 3D API (Interior Furniture & Landscape 3D GLB Synthesis)
MESHY_API_KEY=your_meshy_api_key_here

# Autodesk Platform Services (APS / Forge BIM Cloud Viewing & Translation)
AUTODESK_CLIENT_ID=your_autodesk_client_id_here
AUTODESK_CLIENT_SECRET=your_autodesk_client_secret_here

# Speckle AEC Stream Interoperability (Rhino, Revit, Grasshopper)
SPECKLE_SERVER_URL=https://app.speckle.systems
SPECKLE_TOKEN=your_speckle_personal_access_token_here

# S3-Compatible Object Storage (MinIO / Cloudflare R2 / AWS S3 / GCS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=archai_minio_access
S3_SECRET_KEY=archai_minio_secret
S3_BUCKET=archai-studio-assets

# Next.js Web Frontend Public API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1

# Security & JWT Authentication
JWT_SECRET_KEY=archai_v3_super_secret_architectural_jwt_key_2026
